{
  "name": "johannschopplich/kirby-helpers",
  "description": "Environment variables, meta tags, sitemap, redirects, and Vite",
  "type": "kirby-plugin",
  "version": "7.1.2",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "dotenv",
    "meta-tags",
    "sitemap",
    "redirects",
    "vite"
  ],
  "license": "MIT",
  "homepage": "https://kirby.tools/helpers",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1",
    "vlucas/phpdotenv": "^5"
  },
  "require-dev": {
    "getkirby/cms": "^5",
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "JohannSchopplich\\": "src/classes/"
    }
  },
  "scripts": {
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev --optimize-autoloader"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^5.0"
    }
  }
}
